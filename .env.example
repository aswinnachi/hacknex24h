# ==============================================================================
# AI Vision Security — Environment Configuration (.env.example)
# Use placeholders only. Do NOT commit real production credentials.
# ==============================================================================

# Application Environment
APP_ENV=production
APP_DEBUG=false

# Persistent Database (SQLite or PostgreSQL)
# Local SQLite fallback: sqlite:///./database/app.db
# Cloud PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./database/app.db

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Public Service URLs (Used by frontend & CORS)
PUBLIC_BACKEND_URL=https://your-backend-app.onrender.com
PUBLIC_FRONTEND_URL=https://your-frontend-app.vercel.app

# Computer Vision & Multi-Camera Models
EMBEDDING_MODEL=google/siglip-base-patch16-224
YOLO_MODEL=yolov8s-world.pt
FRAME_SAMPLING_FPS=1.0

# Video Lab Storage Configuration
STORAGE_LOCAL_DIR=data/storage
MAX_UPLOAD_SIZE_MB=250.0

# Optional: Cloud Object Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# Leave empty to use persistent local disk storage
S3_BUCKET_NAME=your-cctv-storage-bucket
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_OR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_OR_R2_SECRET_ACCESS_KEY

# Evidence Retention Policy
EVIDENCE_STORAGE_DIR=data/evidence
EVIDENCE_RETENTION_DAYS=7
MAX_EVIDENCE_STORAGE_GB=10.0
