# Environment configuration
APP_ENV=development
APP_DEBUG=true

# Database
DATABASE_URL=sqlite:///./database/app.db

# API settings
API_HOST=127.0.0.1
API_PORT=8000

# HNX26EPS05 System Architecture Configuration
# Multimodal Embedding Model: google/siglip-base-patch16-224 (SigLIP) or openai/clip-vit-base-patch16 (CLIP)
EMBEDDING_MODEL=google/siglip-base-patch16-224
# Open-Vocabulary Detector: YOLO-World
YOLO_MODEL=yolov8s-world.pt
# Frame Sampling Rate (Selected frames: 1 frame per second)
FRAME_SAMPLING_FPS=1.0
